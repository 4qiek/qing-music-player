{
  "name": "qing-player",
  "version": "1.0.0",
  "description": "清 - 灰白风万能播放器（音乐/视频/图片/书籍/浏览器）",
  "main": "main.js",
  "author": "Qing",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "music-metadata": "^8.0.0",
    "NeteaseCloudMusicApi": "^4.1.1"
  },
  "build": {
    "appId": "com.qing.player",
    "productName": "清",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/qing-icon.ico",
      "artifactName": "清-${version}.exe"
    },
    "portable": {
      "artifactName": "清-${version}.exe"
    }
  }
}
