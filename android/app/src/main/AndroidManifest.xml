<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 权限 ================= -->
    <!-- Android 13（API 33）及以上：媒体音频权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 12（API 32）及以下：旧存储权限，与上面的新权限两者都声明，覆盖全部版本 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 通知栏（媒体通知 + 前台服务通知），Android 13 需运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务：Android 12+ 必须声明 FOREGROUND_SERVICE 与具体类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 实体按键/耳机线控：MediaSession 通过 MediaSessionService 接收，无需额外权限 -->

    <!--
      联网补全封面与歌词（设置 → 在线匹配，可关闭）。
      只在用户开启时才会发起请求，用途仅限于按歌名/艺术家补全本机曲目的封面与歌词。
      ACCESS_NETWORK_STATE 是为了「没网就别发请求」——批量补全时如果不管网络状态，
      每一首都要等满 6 秒超时，一轮 200 首就是二十几分钟，完全是浪费。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 不依赖 Google Play 服务；同时声明硬件/服务非必需，避免被应用商店过滤 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".QingApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Qing"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Qing"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 从文件管理器打开音频文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- 后台播放服务：MediaSessionService，前台服务类型 mediaPlayback -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
             实体按键 / 耳机线控说明（无需额外 receiver）：
             设备的物理播放键与耳机线控发送标准 KEYCODE_MEDIA_*，
             系统把 ACTION_MEDIA_BUTTON 交给 MediaSessionService.onStartCommand，
             Media3 再分发到 MediaSession.Callback.onMediaButtonEvent，
             PlaybackService 里已显式处理全部按键，因此这里不再声明独立 receiver（避免重复响应）。
        -->

    </application>

</manifest>
